{
    "name":  "solaria",
    "version":  "0.8.3",
    "description":  "Solaria Browser",
    "author":  "LazyCatss",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "build":  "electron-builder --win nsis",
                    "build-installer":  "electron-builder --win nsis"
                },
    "dependencies":  {
                         "@capacitor/android":  "^8.5.2",
                         "@capacitor/core":  "^8.5.2",
                         "@supabase/supabase-js":  "^2.57.0",
                         "electron-updater":  "^6.8.9"
                     },
    "devDependencies":  {
                            "@capacitor/cli":  "^8.5.2",
                            "electron":  "^44.0.0",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "extraResources":  [
                                         {
                                             "to":  "Engine/SolariaGame.exe",
                                             "from":  "../Engine/Build-Solaria/Release/SolariaGame.exe"
                                         },
                                         {
                                             "to":  "Engine/MSVCP140.dll",
                                             "from":  "../Engine/Build-Solaria/Release/MSVCP140.dll"
                                         },
                                         {
                                             "to":  "Engine/VCRUNTIME140.dll",
                                             "from":  "../Engine/Build-Solaria/Release/VCRUNTIME140.dll"
                                         },
                                         {
                                             "to":  "Engine/VCRUNTIME140_1.dll",
                                             "from":  "../Engine/Build-Solaria/Release/VCRUNTIME140_1.dll"
                                         },
                                         {
                                             "to":  "Engine/Network/Server",
                                             "from":  "../Engine/Network/Server"
                                         },
                                         {
                                             "to":  "Engine/Network/Server/node_modules/ws",
                                             "from":  "../Engine/Network/Server/node_modules/ws"
                                         }
                                     ],
                  "appId":  "com.solaria.browser",
                  "productName":  "Solaria",
                  "icon":  "build/icon.ico",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "main.js",
                                "preload.js",
                                "installer/**/*",
                                "package.json"
                            ],
                  "publish":  {
                                  "provider":  "github",
                                  "owner":  "lazycatss14",
                                  "repo":  "Solaria",
                                  "releaseType":  "release"
                              },
                  "win":  {
                              "target":  "nsis",
                              "artifactName":  "Solaria-Setup.exe"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Solaria",
                               "runAfterFinish":  false
                           }
              }
}